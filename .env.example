# Copy to .env and fill in. .env is gitignored and holds real secrets.
# See docs/setup/gcp_setup.md for how to obtain the Google values.

# Host-side value. The api container overrides DATABASE_URL in docker-compose.yml
# with the db:5432 form, so this one is read only by commands run on the host,
# such as `alembic upgrade head`. Port 5432 is published, so localhost reaches
# the same database. This names the production database: see the warning in
# README.md before exporting it into your own shell.
DATABASE_URL=postgresql+asyncpg://doer:doer@localhost:5432/doer

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
GOOGLE_SCOPES="openid email profile https://www.googleapis.com/auth/calendar.freebusy"

ANTHROPIC_API_KEY=
ESTIMATION_MODEL=claude-haiku-4-5
CHAT_MODEL=claude-opus-5

# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable. Rotating it makes every stored refresh token undecryptable.
FERNET_KEY=

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Everything below has a working default in backend/doer/config.py and is listed
# here so the file is a complete inventory of what the application reads. Delete
# a line to take the default. Settings is configured extra="ignore", so a
# misspelled name is dropped silently rather than rejected: check spelling here
# against config.py rather than expecting a startup error.
SESSION_TTL_DAYS=30

# The in-process estimation sweeper, and the fire-and-forget attempt on task
# creation. The tests disable the latter so a detached task cannot outlive the
# fixtures that own its rows.
SWEEPER_ENABLED=true
SWEEPER_INTERVAL_SECONDS=60
BACKGROUND_ESTIMATION_ENABLED=true
ESTIMATION_MAX_ATTEMPTS=3
